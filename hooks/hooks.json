{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "e=\"${CLAUDE_PLUGIN_ROOT}/skills/codebase-analyzer/scripts/DeclIndex/DeclIndex.Hook/bin/Release/net10.0/DeclIndex.Hook.exe\"; if [ -f \"$e\" ]; then \"$e\"; else pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ps1\"; fi",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Glob|Grep|Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "e=\"${CLAUDE_PLUGIN_ROOT}/skills/codebase-analyzer/scripts/DeclIndex/DeclIndex.Hook/bin/Release/net10.0/DeclIndex.Hook.exe\"; [ -f \"$e\" ] && \"$e\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "e=\"${CLAUDE_PLUGIN_ROOT}/skills/codebase-analyzer/scripts/DeclIndex/DeclIndex.Hook/bin/Release/net10.0/DeclIndex.Hook.exe\"; [ -f \"$e\" ] && \"$e\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
